--cpu Cortex-M3
"t3\startup_stm32f103xb.o"
"t3\main.o"
"t3\gpio.o"
"t3\tim.o"
"t3\stm32f1xx_it.o"
"t3\stm32f1xx_hal_msp.o"
"t3\stm32f1xx_hal_gpio_ex.o"
"t3\stm32f1xx_hal_tim.o"
"t3\stm32f1xx_hal_tim_ex.o"
"t3\stm32f1xx_hal.o"
"t3\stm32f1xx_hal_rcc.o"
"t3\stm32f1xx_hal_rcc_ex.o"
"t3\stm32f1xx_hal_gpio.o"
"t3\stm32f1xx_hal_dma.o"
"t3\stm32f1xx_hal_cortex.o"
"t3\stm32f1xx_hal_pwr.o"
"t3\stm32f1xx_hal_flash.o"
"t3\stm32f1xx_hal_flash_ex.o"
"t3\stm32f1xx_hal_exti.o"
"t3\system_stm32f1xx.o"
--strict --scatter "T3\T3.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "T3.map" -o T3\T3.axf