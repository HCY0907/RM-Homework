--cpu Cortex-M3
"t2\startup_stm32f103xb.o"
"t2\main.o"
"t2\gpio.o"
"t2\tim.o"
"t2\stm32f1xx_it.o"
"t2\stm32f1xx_hal_msp.o"
"t2\stm32f1xx_hal_gpio_ex.o"
"t2\stm32f1xx_hal_tim.o"
"t2\stm32f1xx_hal_tim_ex.o"
"t2\stm32f1xx_hal.o"
"t2\stm32f1xx_hal_rcc.o"
"t2\stm32f1xx_hal_rcc_ex.o"
"t2\stm32f1xx_hal_gpio.o"
"t2\stm32f1xx_hal_dma.o"
"t2\stm32f1xx_hal_cortex.o"
"t2\stm32f1xx_hal_pwr.o"
"t2\stm32f1xx_hal_flash.o"
"t2\stm32f1xx_hal_flash_ex.o"
"t2\stm32f1xx_hal_exti.o"
